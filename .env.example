# Copy to .env and set values in your shell/platform. Never commit real secrets.
# The server reads process.env; it does not load .env automatically.

# Development defaults to 8787; production defaults to 3000.
PORT=8787
HOST=0.0.0.0

# Optional: absolute path to a built data directory (default: ./data/build).
UNISCOPE_DATA_DIR=./data/build

# Set to 1 to validate every record against the Zod schema on startup.
# Startup is slower and uses more memory; recommended after an ingest.
UNISCOPE_VALIDATE_DATA=0

# Correction-report queue (JSONL). Use a persistent volume in production.
# Ignored when Supabase is configured.
REPORT_STORE_DIR=./data/runtime

# Durable report storage (required on Vercel). Run supabase/schema.sql first.
# The service role key must only ever be set server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_REPORTS_TABLE=reports

# Admin review is disabled unless this is set to at least 24 characters.
# Generate with: openssl rand -base64 32
ADMIN_TOKEN=

# Optional session-signing secret. If omitted, a key is derived from ADMIN_TOKEN.
# ADMIN_SESSION_SECRET=

# Set to 1 only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0

# Some sandboxes need an explicit CA bundle for Node's TLS client.
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
